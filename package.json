{
  "name": "dsh-remote-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Agent-side DSH host plugin: publishes this process's launch token and identity to $DSH_HOME/remote-agent.json so a hub can authenticate without manual token pasting.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "ARCHITECTURE.md",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "TODO.md",
    "docs",
    "scripts/install.sh",
    "scripts/check.mjs"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote",
    "ssh"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhuan416/dsh-remote-agent.git"
  },
  "homepage": "https://github.com/yhuan416/dsh-remote-agent#readme",
  "bugs": {
    "url": "https://github.com/yhuan416/dsh-remote-agent/issues"
  },
  "icon": "./icon.svg",
  "scripts": {
    "check": "node scripts/check.mjs"
  }
}
